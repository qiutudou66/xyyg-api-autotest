# 复制成 .env 后按自己的环境改。.env 不要提交到 Git。
BASE_URL=http://127.0.0.1:8081

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=123456

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=123456
MYSQL_DB=hmdp

# 测试数据前缀：用户手机号 / 店铺和动态名称都靠它识别和清理
TEST_PHONE_PREFIX=1390000
TEST_NAME_PREFIX=AUTOTEST_

# 后端上传目录（SystemConstants.IMAGE_UPLOAD_DIR）
IMAGE_UPLOAD_DIR=D:\code.java\hm-dianping\frontend\public\imgs

# 临时文件目录（测试生成的图片放这里）
TEST_TEMP_DIR=E:\tmp_hmdp\autotest

# Java 后端写死请求 localhost:8000，mock 服务监听这个端口
AI_MOCK_HOST=127.0.0.1
AI_MOCK_PORT=8000
